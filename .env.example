# Copia este archivo a .env para probar en local. En Scalingo estas variables se
# configuran en el panel de la app (Environment), NO en el repositorio.

NODE_ENV=production
# Dirección pública de la web (sin barra final). Debe coincidir con la Redirect URI
# registrada en Patreon: <BASE_URL>/auth/patreon/callback
BASE_URL=https://setups.cyminversores.com

# Base de datos. Scalingo crea SCALINGO_POSTGRESQL_URL al añadir PostgreSQL;
# no hace falta definir DATABASE_URL (se usa esa).
# DATABASE_URL=postgres://usuario:clave@host:5432/base

# Cadena aleatoria de 32+ caracteres (genera una con: openssl rand -base64 48)
SESSION_SECRET=

# Patreon (portal de desarrolladores)
PATREON_CLIENT_ID=tPt4PYC5ukHtxwRfkIVQJjv3ACJodY1ciJofWjGhhHOIkRZ3HFvv7D302oRtpyvQ
PATREON_CLIENT_SECRET=
# Opcional: se detecta sola cuando entra la cuenta de creador, o se puede fijar en el panel.
# PATREON_CAMPAIGN_ID=
# Opcional: secreto del webhook (avisos inmediatos de bajas y cambios de nivel).
# PATREON_WEBHOOK_SECRET=
# Opcional: enlace público de vuestra página en Patreon (botón «Ver niveles»).
# PATREON_PAGE_URL=https://www.patreon.com/tu-pagina

# Quién administra (al menos uno). Email de la cuenta de Patreon con la que se entra.
ADMIN_EMAILS=
# ADMIN_PATREON_IDS=

# Ajustes con valores razonables por defecto
# RECHECK_HOURS=12
# PATREON_GRACE_HOURS=48
# SESSION_DAYS=30
# SEED_WATCHLIST=true
